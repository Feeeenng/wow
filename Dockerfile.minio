# 固定官方发行二进制和摘要，避免已不可用的社区镜像标签；仅支持当前 x86_64 部署。
FROM python:3.11.17-slim-bookworm

RUN python - <<'PY'
import hashlib
import urllib.request
from pathlib import Path

url = "https://github.com/minio/minio/releases/download/RELEASE.2025-09-07T16-13-09Z/minio.linux-amd64.RELEASE.2025-09-07T16-13-09Z"
expected = "7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f"
target = Path("/usr/local/bin/minio")
with urllib.request.urlopen(url, timeout=120) as response, target.open("wb") as output:
    while block := response.read(1024 * 1024):
        output.write(block)
if hashlib.file_digest(target.open("rb"), "sha256").hexdigest() != expected:
    raise SystemExit("MinIO SHA-256 mismatch")
target.chmod(0o755)
PY
RUN useradd --create-home --uid 10001 minio && mkdir /data && chown 10001:10001 /data
USER 10001
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
