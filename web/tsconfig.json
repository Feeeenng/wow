{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "antd": ["node_modules/antd"],
      "@/shared/*": ["../shared/*"],
      "@/spell-pack": ["../client/src-tauri/resources/game-data/spells.json"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "../shared"]
}
