{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW Recorder",
  "version": "0.1.0",
  "identifier": "com.wow.recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WoW Recorder",
        "width": 1680,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 760,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
