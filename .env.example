# 本机 Docker PostgreSQL；密码由 init-cloud.ps1 生成，不使用演示默认口令。
WOW_POSTGRES_USER=wow
WOW_POSTGRES_DB=wow
WOW_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_DATABASE_PASSWORD

# 私有对象存储凭证，仅后端和 MinIO 使用，不返回桌面端。
WOW_S3_ACCESS_KEY=REPLACE_WITH_GENERATED_STORAGE_ACCESS_KEY
WOW_S3_SECRET_KEY=REPLACE_WITH_GENERATED_STORAGE_SECRET_KEY
WOW_S3_BUCKET=wow-recordings
WOW_S3_REGION=us-east-1
WOW_S3_ADDRESSING_STYLE=path
# 桌面能访问的对象地址；部署到服务器时改成实际 HTTPS 地址。
WOW_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:19000

# 用户视频上传与短期签名限制，服务端仍会校验实际分片。
WOW_MULTIPART_PART_SIZE_BYTES=67108864
WOW_UPLOAD_URL_TTL_SECONDS=900

# 私有播放只签发短期授权，不把平台访问令牌放进视频 URL。
WOW_PUBLIC_API_URL=http://127.0.0.1:18000
WOW_PLAYBACK_SIGNING_KEY=REPLACE_WITH_GENERATED_PLAYBACK_SIGNING_KEY
# 异步任务永久状态保存在 PostgreSQL，Redis 仅传递任务消息。
WOW_REDIS_URL=redis://redis:6379/0
WOW_PROCESSING_TIMEOUT_SECONDS=1800
WOW_PROCESSING_LEASE_SECONDS=3600
WOW_PROCESSING_MAX_ATTEMPTS=3

# 可选 WCL 公共报告导入；使用自己创建的应用凭证，仅后端读取，留空则明确禁用。
WOW_WCL_CLIENT_ID=
WOW_WCL_CLIENT_SECRET=
# 中国区凭证若需区域 endpoint，可由部署者同时调整 token 和 GraphQL 地址。
WOW_WCL_TOKEN_URL=https://www.warcraftlogs.com/oauth/token
WOW_WCL_API_URL=https://www.warcraftlogs.com/api/v2/client
